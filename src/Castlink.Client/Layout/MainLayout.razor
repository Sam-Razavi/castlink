@inherits LayoutComponentBase
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>

        @* TMDB requires this attribution on every page, not just the About page — see
           docs/PLAN.md section 4 and Phase 3. *@
